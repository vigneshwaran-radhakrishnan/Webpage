\contentsline {chapter}{\numberline {1}Home}{1}{chapter.1}%
\ttl@starttoc {chapter@1}
\contentsline {section}{\numberline {1.1}section 1 in chapter 1}{1}{section.1.1}%
\contentsline {section}{\numberline {1.2}section 2 in chapter 1}{2}{section.1.2}%
\contentsline {subsection}{\numberline {1.2.1}subsection 1 in section 2 in chapter 1}{2}{subsection.1.2.1}%
\contentsline {section}{\numberline {1.3}section 3 in chapter 1}{3}{section.1.3}%
\ttl@stoptoc {chapter@1}
\contentsline {chapter}{\numberline {2}chapter 2}{4}{chapter.2}%
\contentsline {section}{\numberline {2.1}section 1 in chapter 2}{4}{section.2.1}%
\contentsline {section}{\numberline {2.2}section 2 in chapter 2}{5}{section.2.2}%
\contentsline {subsection}{\numberline {2.2.1}subsection 1 in section 2 in chapter 2}{5}{subsection.2.2.1}%
\contentsline {section}{\numberline {2.3}section 3 in chapter 2}{6}{section.2.3}%
\contentsfinish 
